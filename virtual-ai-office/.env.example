#--------------------------------------------------------------------
# Virtual AI Office — copy to .env and fill in. NEVER commit .env.
# Secrets live only here (server side); they are never sent to the browser.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

app.baseURL = 'https://office.example.com/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (MySQL 8 / MariaDB 10.6+)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = virtual_ai_office
database.default.username = vao_user
database.default.password =
database.default.DBDriver = MySQLi
database.default.charset  = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci
database.default.port     = 3306

# Local development without MySQL:
# database.default.DBDriver = SQLite3
# database.default.database = office.db
# database.default.foreignKeys = true
# SQLite allows one writer: give concurrent requests + agents:work time to wait instead of "database is locked"
# database.default.busyTimeout = 5000

#--------------------------------------------------------------------
# ENCRYPTION (generate with: php spark key:generate)
# Used to encrypt tenant secrets (tenant_settings, AI tool secret headers). Required for tools
# with a secret header; changing it makes stored secrets unreadable (re-enter them).
#--------------------------------------------------------------------
encryption.key =

#--------------------------------------------------------------------
# SESSION — use Redis/database handler in production for multiple app servers
#--------------------------------------------------------------------
# session.driver = 'CodeIgniter\Session\Handlers\RedisHandler'
# session.savePath = 'tcp://127.0.0.1:6379'

#--------------------------------------------------------------------
# TRIPAY — https://tripay.co.id/member (Merchant > Detail / API)
# Callback URL to enter in the Tripay dashboard: {app.baseURL}webhooks/tripay
#--------------------------------------------------------------------
tripay.mode          = sandbox
tripay.merchantCode  =
tripay.apiKey        =
tripay.privateKey    =
# Payment window offered to customers (minutes), capped by the invoice due date
tripay.expiryMinutes = 1440
# Re-read every PAID callback from Tripay's API before activating (recommended)
tripay.verifyWithApi = true
# Optional: comma-separated Tripay callback IPs to accept (empty = any IP, signature still required)
tripay.callbackAllowedIps =
# Development only (ignored in production): local Tripay mock server
# tripay.baseUrlOverride = 'http://127.0.0.1:8091/api-sandbox/'

#--------------------------------------------------------------------
# AI ENGINE — Claude API (official PHP SDK anthropic-ai/sdk)
#--------------------------------------------------------------------
ai.anthropicApiKey  =
# Default for new agents; tenants can pick another model from ai_models per agent
ai.defaultModel     = claude-opus-5-5
ai.maxTokens        = 16000
# Worker attempts per task for transient errors (rate limit, overload, network)
ai.taskMaxAttempts  = 3
# Server-side refusal fallback (beta) on models that support it
ai.refusalFallback  = true
# Max model↔tool round trips per task before it fails (Phase 3.3)
ai.maxToolRounds    = 8
# Development only (ignored in production): local mock of the Messages API
# ai.baseUrlOverride = 'http://127.0.0.1:8092'
# Development only (ignored in production): let tools call localhost/private IPs, plain http and any port
# ai.toolsAllowPrivateNetwork = true

#--------------------------------------------------------------------
# QUEUE (Phase 3) — background jobs for agent tasks
#--------------------------------------------------------------------
# queue.redis = 'tcp://127.0.0.1:6379'
